# Copy to a private file; absolute paths are recommended on PythonAnywhere.
ALARMTREND_DATA_DIR=/home/YOUR_USERNAME/.local/share/alarmtrend
ALARMTREND_START_DATE=2026-09-01
ALARMTREND_SOURCE_URL=https://kyiv.digital/storage/air-alert/stats.html
ALARMTREND_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# Generate using: python -m alarmtrend password-hash
ALARMTREND_ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
ALARMTREND_SECURE_COOKIE=true
ALARMTREND_INTERVAL=300
ALARMTREND_TIMEOUT=30
